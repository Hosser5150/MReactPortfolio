{
  "name": "discord-music-bot",
  "version": "0.1.0",
  "description": "A TypeScript Discord music bot scaffold with YouTube, YouTube Music, Spotify metadata bridging, and queue controls.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "commands:deploy": "tsx src/deploy-commands.ts",
    "commands:deploy:global": "cross-env DEPLOY_GLOBAL_COMMANDS=true tsx src/deploy-commands.ts",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop discord-music-bot",
    "pm2:logs": "pm2 logs discord-music-bot"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/opus": "^0.10.0",
    "@snazzah/davey": "^0.1.11",
    "discord-player": "^7.2.0",
    "discord-player-youtubei": "^3.0.0-beta.4",
    "discord-voip": "^7.2.0",
    "discord.js": "^14.26.3",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "youtube-dl-exec": "^3.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "pm2": "^5.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
