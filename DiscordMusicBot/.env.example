DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Recommended for fast command iteration while developing.
# Leave blank and set DEPLOY_GLOBAL_COMMANDS=true to deploy global commands.
DISCORD_GUILD_ID=your_test_server_id_here

# Playback defaults.
DEFAULT_VOLUME=70
LEAVE_ON_EMPTY_COOLDOWN_MS=300000
VOICE_CONNECTION_TIMEOUT_MS=120000
MUSIC_DEBUG=false
